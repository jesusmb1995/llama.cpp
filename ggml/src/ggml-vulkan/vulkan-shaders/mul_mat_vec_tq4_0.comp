#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "mul_mat_vec_base.glsl"
#include "tq_utils.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

shared float s_dequant[QUANT_K];

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;
    const uint tid = gl_LocalInvocationID.x;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    const float sign = tq_get_sign(tid);
    const float inv_sqrt_d = 0.08838834764831845;
    const uint sub_lane = gl_SubgroupInvocationID;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint ib0 = a_offset / QUANT_K + (first_row + n) * num_blocks_per_row;

        for (uint blk = 0; blk < num_blocks_per_row; ++blk) {
            const uint ib = ib0 + blk;
            const float norm = float(data_a[ib].d);

            // Unpack 4-bit nibble index and codebook lookup
            const uint byte_idx = tid / 2u;
            const uint nibble = (tid % 2u == 0u)
                ? (uint(data_a[ib].qs[byte_idx]) & 0x0Fu)
                : (uint(data_a[ib].qs[byte_idx]) >> 4u);

            float val = TQ4_CB[nibble];

            // Inverse FHT: subgroup stages (no barriers needed)
            for (uint half_s = 1u; half_s < gl_SubgroupSize && half_s < QUANT_K; half_s <<= 1u) {
                const uint partner = sub_lane ^ half_s;
                float other = subgroupShuffle(val, partner);
                if ((sub_lane & half_s) == 0u) {
                    val = val + other;
                } else {
                    val = other - val;
                }
            }

            // Inverse FHT: shared memory stages (need barriers)
            s_dequant[tid] = val;
            barrier();
            for (uint half_s = gl_SubgroupSize; half_s < QUANT_K; half_s <<= 1u) {
                const uint stride = half_s << 1u;
                float a, b;
                if ((tid % stride) < half_s) {
                    a = s_dequant[tid];
                    b = s_dequant[tid + half_s];
                } else {
                    a = s_dequant[tid - half_s];
                    b = s_dequant[tid];
                }
                barrier();
                s_dequant[tid] = ((tid % stride) < half_s) ? (a + b) : (a - b);
                barrier();
            }
            val = s_dequant[tid];

            const FLOAT_TYPE dequant_val = FLOAT_TYPE(val * sign * inv_sqrt_d * norm);

            [[unroll]] for (uint jcol = 0; jcol < NUM_COLS; ++jcol) {
                temp[jcol][n] += dequant_val * FLOAT_TYPE(data_b[jcol * p.batch_stride_b + b_offset + blk * QUANT_K + tid]);
            }

            barrier();
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
